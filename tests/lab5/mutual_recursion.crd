// isEven calls isOdd before isOdd is declared: names are looked up when the
// call runs, so mutual recursion needs no forward declaration.
func isEven(n) {
    if (n == 0) return true;
    return isOdd(n - 1);
}
func isOdd(n) {
    if (n == 0) return false;
    return isEven(n - 1);
}
print isEven(10); // expect: true
print isOdd(7);   // expect: true
print isEven(3);  // expect: false