var n = 0;
while (n < 5) {
    n = n + 1;
    if (n == 1) continue;
    print n; // expect: 2
             // expect: 3
    if (n == 3) break;
}

var i = 0;
for (; i < 6; i = i + 1) {
    if (i == 1) continue;
    while (true) { break; }
    if (i == 3) break;
    print i; // expect: 0
             // expect: 2
}
print i; // expect: 3

for (;;) {
    { break; }
    print "unreachable";
}
print "done"; // expect: done
