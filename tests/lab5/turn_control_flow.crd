var i = 0;
var score = 0;
for (; i < 3; i = i + 1) {
    // Block must be cleared even when continue exits the preceding turn.
    print block(player, 0); // expect: 0
                            // expect: 0
                            // expect: 0
    turn {
        block(player, 10);
        switch (i) {
            case 0: continue;
            case 1: break;
            default: score = score + 1;
        }
        score = score + 10;
    }
}
print i; // expect: 3
print score; // expect: 21
print block(player, 0); // expect: 0
